      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://wild-pjok.adi-edwinconsultants.workers.dev/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
