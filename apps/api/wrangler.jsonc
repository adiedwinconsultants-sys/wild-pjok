{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wild-pjok",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ENV": "production",
    "ACCESS_TOKEN_TTL": "900",
    "CORS_ORIGIN": "https://pjok.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pjok-production",
      "database_id": "e16f9017-c4c9-41b0-a7d1-664ee51ff848",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EXPORTS",
      "bucket_name": "pjok-exports-production"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "7c769cada65f4b8aa302eb3dfe4f6496"
    }
  ],
  "env": {
    "staging": {
      "name": "wild-pjok-staging",
      "vars": {
        "APP_ENV": "staging",
        "ACCESS_TOKEN_TTL": "900",
        "CORS_ORIGIN": "https://staging.pjok.example.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pjok-staging",
          "database_id": "b68b9e05-3c4b-4826-8456-4ac5af4839f7",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "pjok-exports-staging" }],
      "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "268dea40c60241d2982af2bfca6c7ac9" }]
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "ACCESS_TOKEN_TTL": "900",
        "CORS_ORIGIN": "https://pjok.example.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pjok-production",
          "database_id": "e16f9017-c4c9-41b0-a7d1-664ee51ff848",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "EXPORTS", "bucket_name": "pjok-exports-production" }],
      "kv_namespaces": [{ "binding": "RATE_LIMIT", "id": "7c769cada65f4b8aa302eb3dfe4f6496" }]
    }
  }
}
