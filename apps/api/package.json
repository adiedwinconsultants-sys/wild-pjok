{
  "name": "@pjok/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply pjok-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply pjok-production --remote --env production",
    "db:seed:local": "tsx scripts/generate-seed-sql.ts && wrangler d1 execute pjok-production --local --file=src/db/seed/catalog.sql",
    "db:seed:demo": "tsx scripts/generate-demo-sql.ts && wrangler d1 execute pjok-production --local --file=src/db/seed/demo.sql",
    "db:seed": "pnpm db:seed:local && pnpm db:seed:demo",
    "dump-catalog": "pnpm --filter @pjok/shared dump-catalog"
  },
  "dependencies": {
    "@pjok/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1",
    "xlsx": "file:../../vendor/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.19.2",
    "typescript": "5.7.2",
    "vite": "8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
